{
    "dbServer": "IP_ИЛИ_ХОСТ_СЕРВЕРА_БД", // например: "192.168.1.100" или "sql.company.local"
    "dbPort": 1433, // порт SQL Server (стандартный 1433)
    "dbUser": "ЛОГИН_ПОЛЬЗОВАТЕЛЯ_SQL", // например: "sa" или "mes_user"
    "dbPassword": "ПАРОЛЬ_ПОЛЬЗОВАТЕЛЯ_SQL", // пароль от БД
    "dbName": "ИМЯ_БАЗЫ_ДАННЫХ", // например: "EMC_MES" или "EMC_Production"
    "serverPort": 8080, // порт веб-сервера (8080 для отладки, 80 для продакшена)
    "debug": true, // true - отладочный режим (больше логов), false - боевой
    "shifts": { // настройки смен
        "1": {
            "name": "1 смена", // название смены
            "start": "06:30:00", // время начала смены (HH:MM:SS)
            "end": "14:59:59" // время окончания смены (HH:MM:SS)
        },
        "2": {
            "name": "2 смена",
            "start": "15:00:00",
            "end": "23:29:59"
        },
        "3": {
            "name": "3 смена",
            "start": "23:30:00", // начало ночной смены
            "end": "06:29:59", // окончание на следующий день
            "crossesMidnight": true // признак, что смена переходит через полночь
        }
    },
    "trassir": {
        "address": "URL_СЕРВЕРА_TRAСSIR", // полный URL сервера видеонаблюдения, например "https://cctv.company.local:8080/"
        "username": "ЛОГИН_ПОЛЬЗОВАТЕЛЯ", // логин для доступа к Trassir
        "password": "ПАРОЛЬ_ПОЛЬЗОВАТЕЛЯ" // пароль для доступа к Trassir
    }
}